# DigitalOcean App Platform restricted-pilot values. Keep secret values out of Git.
# Runtime service only; never expose this credential to the migration job.
YARVIS_DATABASE_URL=
# Separate migration job only; never expose this credential to the runtime service.
YARVIS_MIGRATOR_DATABASE_URL=
# Founder Enrollment runner only; never provide this credential to runtime or migration.
YARVIS_FOUNDER_BOOTSTRAP_DATABASE_URL=
# Founder Enrollment runner only; configure as an encrypted one-shot secret, never as a file in Git.
YARVIS_FOUNDER_ENROLLMENT_AUTHORIZATION=
YARVIS_FOUNDER_BOOTSTRAP_PUBLIC_KEY=
YARVIS_FOUNDER_BOOTSTRAP_KEY_ID=
YARVIS_OIDC_ISSUER=
YARVIS_OIDC_CLIENT_ID=
YARVIS_OIDC_CLIENT_SECRET=
YARVIS_OIDC_ATTEMPT_ENCRYPTION_KEY=
# Register only after App Platform has assigned the exact managed subdomain.
YARVIS_OIDC_REDIRECT_URI=__REQUIRES_EXACT_APP_PLATFORM_CALLBACK__
YARVIS_CORS_ORIGINS=__REQUIRES_EXACT_APP_PLATFORM_ORIGIN__
YARVIS_CSRF_ALLOWED_ORIGINS=__REQUIRES_EXACT_APP_PLATFORM_ORIGIN__
