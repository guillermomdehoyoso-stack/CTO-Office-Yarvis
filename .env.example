# Local development examples only.
# Do not use these values in shared, staging, or production environments.
# Change credentials before any deployment outside your local machine.
POSTGRES_DB=yarvis
POSTGRES_USER=yarvis
POSTGRES_PASSWORD=yarvis
# Docker Compose derives YARVIS_DATABASE_URL for the API from the values above.
# Direct API execution uses the YARVIS_ prefix; do not place real production values here.
YARVIS_ENVIRONMENT=local
YARVIS_LOG_LEVEL=INFO
YARVIS_DOCUMENT_STORAGE_ROOT=/data/yarvis
